/* Copy this file to config/wifi_secrets.h and fill in real values.
 * config/wifi_secrets.h is gitignored — never commit real credentials.
 * device_config.h includes it automatically if present.
 */
#ifndef WIFI_SECRETS_H
#define WIFI_SECRETS_H

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

/* LAN IP of the PC running the FastAPI backend (uvicorn --host 0.0.0.0). */
#define GATEWAY_HOST  "192.168.1.10"
#define GATEWAY_PORT  8000

/* Must match backend DEVICE_ID (default DEVICE_001). */
#define DEVICE_ID     "DEVICE_001"

/* Set to the backend DEVICE_TOKEN when API authentication is enabled. */
/* #define DEVICE_TOKEN "replace-with-device-token" */

#endif
