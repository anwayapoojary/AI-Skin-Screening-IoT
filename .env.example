APP_NAME=AI Health Screening Device
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
API_V1_PREFIX=/api/v1

AUTH_ENABLED=false
AUTH_ISSUER=ai-health-screening-device

DATABASE_URL=sqlite:///./data/app.db

# simulation until the ESP32-CAM kit is received, flashed, and talking Wi-Fi.
# Set DEVICE_MODE=real once the firmware connects to /ws/device.
DEVICE_MODE=simulation
DEVICE_ID=DEVICE_001
PROTOCOL_VERSION=1.0

# Device token for /ws/device and device HTTP endpoints.
# Empty = open (development). Set a random string in production.
DEVICE_TOKEN=

# mock = deterministic dev model. real = trained skin-lesion model (see docs/ai.md).
AI_MODE=mock
# Real model config (only used when AI_MODE=real):
SCREENING_MODEL_PATH=./ai/weights/skin_model.pt
SCREENING_MODEL_ARCH=efficientnet_b0
SCREENING_CLASS_NAMES=akiec,bcc,bkl,df,mel,nv,vasc
SCREENING_SUSPICIOUS_LABELS=mel,bcc,akiec
# Abstain threshold: to be set from YOUR validation data.
SCREENING_ABSTAIN_THRESHOLD=0.55
SCREENING_TTA=false

SIMULATOR_HOST=127.0.0.1
SIMULATOR_PORT=8090

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# Firmware Wi-Fi (device only — never commit real passwords)
# WIFI_SSID=
# WIFI_PASSWORD=
# GATEWAY_WS_URL=ws://192.168.1.10:8000/ws/device
